#### Core Configuration

DATABASE_URL=postgresql+psycopg2://postgres.your-project-ref:your-password@aws-0-us-west-1.pooler.supabase.com:6543/postgres
REDIS_URL=redis://queue:6379/0
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-west-1.pooler.supabase.com:6543/postgres
SUPABASE_STORAGE_BUCKET=runs


#### API Configuration
API_CORS_ORIGIN=http://localhost:3000



#### Test Generation- LLM Configuration
OPENAI_API_KEY=
GENERATE_TESTS_MODEL=gpt-4.1-mini
GENERATE_TESTS_MAX_TOKENS=8000
GENERATE_TESTS_TEMPERATURE=0.2
GENERATE_TESTS_MAX_TARGETS_PER_RUN=50
GENERATE_TESTS_OUTPUT_DIR=generated_tests
GENERATE_TESTS_ENABLE_SERVICE_FUNCTIONS=true
GENERATE_TESTS_ENABLE_API_ENDPOINTS=true


#### Port Configuration
API_PORT=8000
CLIENT_PORT=3000
RQ_DASHBOARD_PORT=9181
